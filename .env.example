# All variables are optional. Without them the app runs in demo mode.

# Postgres connection string (Neon or Supabase via the Vercel Marketplace).
# Run db/migrations/001_reportes.sql once against it.
DATABASE_URL=

# Token municipal operators use to change a report's status (long random string).
ADMIN_TOKEN=

# Set to "false" to hide the simulated scenario once real data is available.
DATOS_SIMULADOS=true

# Public URL, used for metadata and the sitemap.
NEXT_PUBLIC_SITE_URL=https://calle-justa.vercel.app
